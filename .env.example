# Copy this file to .env and change the values. NEVER commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=fileservice
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_DB=fileservice
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (job queue) ---
REDIS_URL=redis://redis:6379/0

# --- S3 (LocalStack in dev; remove S3_ENDPOINT_URL for real AWS) ---
S3_ENDPOINT_URL=http://localstack:4566
S3_BUCKET=secure-files
S3_REGION=us-east-1
# LocalStack accepts any dummy credentials. Use real IAM creds only in AWS.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- ClamAV ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Request authentication ---
# Master secret used to derive each API key's signing secret. REQUIRED.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Changing it later invalidates every existing signing secret.
SIGNING_MASTER_SECRET=
# Signed requests older/newer than this many seconds are rejected.
SIGNATURE_WINDOW_SECONDS=300
RATE_LIMIT_PER_MINUTE=60

# --- Compression ---
# lossy = much smaller images, tiny quality loss. lossless = exact pixels.
IMAGE_MODE=lossy
IMAGE_QUALITY=80
ZSTD_LEVEL=15
# Images with more pixels than this are rejected (decompression-bomb guard).
MAX_IMAGE_PIXELS=50000000

# --- Housekeeping ---
# Days to keep a FAILED job's quarantined file for investigation.
FAILED_RETENTION_DAYS=7
# Finished job rows older than this move to the archive table.
ARCHIVE_AFTER_DAYS=90

# --- S3 bucket setup (python -m app.s3setup apply) ---
QUARANTINE_EXPIRE_DAYS=7
LIFECYCLE_IA_DAYS=30
LIFECYCLE_GLACIER_DAYS=90
# Only used to estimate cost in reports (S3 Standard, us-east-1).
S3_PRICE_PER_GB_MONTH=0.023

# --- Uploads ---
# Maximum accepted file size in bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400
